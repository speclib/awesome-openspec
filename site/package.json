  "scripts": {
    "sync-data": "node -e \"const fs=require('fs');fs.mkdirSync('src/data',{recursive:true});const src=fs.existsSync('../data/entries.json')?'../data/entries.json':'src/data/entries.fixture.json';fs.copyFileSync(src,'src/data/entries.json');console.log('using',src)\"",
